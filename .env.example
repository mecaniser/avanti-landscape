DATABASE_URL="postgresql://user:password@localhost:5432/avanti?schema=public"

AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="set-a-strong-password"

# Break-glass admin (optional). A standing agency login that works even if the
# client's account is changed or deleted. Set BOTH to enable. The password is
# stored ONLY as a bcrypt hash, never in plaintext:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-master-password'
# IMPORTANT: in a .env file, escape every `$` in the hash as `\$` — otherwise
# Next's env loader expands `$2b`/`$10`/... and corrupts it. Platform env
# dashboards (Railway, Vercel) take the raw unescaped hash.
MASTER_ADMIN_EMAIL=""
MASTER_ADMIN_PASSWORD_HASH=""

RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="owner@example.com"

# Sender for lead notification emails. Defaults to Resend's shared sandbox
# address (onboarding@resend.dev), which only delivers to the Resend account
# owner's own verified address. Once avantilandscapingnc.com is verified in
# Resend, set this to a real sender on that domain.
LEAD_NOTIFICATION_FROM="Avanti Landscaping Website <noreply@avantilandscapingnc.com>"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Canonical public origin, no trailing slash. Used for canonical URLs, Open
# Graph tags, the sitemap, robots.txt, and JSON-LD. `www` is canonical; the
# apex should 301 to it.
NEXT_PUBLIC_SITE_URL=https://www.avantilandscapingnc.com

# GA4 web data stream measurement ID (for example, G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Server-only key restricted to Places API (New). Never prefix with NEXT_PUBLIC.
GOOGLE_PLACES_API_KEY=""
